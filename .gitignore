# Dependencias y artefactos de compilación
node_modules/
dist/
*.tsbuildinfo

# Credenciales locales. Nunca se commitean: los ambientes declaran el *nombre*
# de cada secreto (ambientes/*.json), nunca su valor.
.env
.env.*
!.env.ejemplo
.conductor/settings.local.toml # configuración y secretos de Conductor en esta máquina

# Sistema operativo y editores
.DS_Store

# Las corridas de evals/ dejan transcripts, diffs y expedientes pesados; se
# versiona solo el .json de resumen de cada corrida.
evals/resultados/*
!evals/resultados/*.json

# Caché de Python (evals/run.py)
__pycache__/
*.pyc
