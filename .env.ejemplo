# Copia este archivo a .env (que está en .gitignore) y pon tus valores locales.
# Acá no va ningún valor real: este archivo sí se commitea.

# Cuál de los ambientes/*.json se carga. Sin esto, el proceso no arranca.
PAGAYA_AMBIENTE=dev

# Secretos declarados en ambientes/dev.json
PAGAYA_BD_URL=postgres://pagaya:pagaya@localhost:5432/pagaya_dev
PAGAYA_FIRMA_SESION=cambia-esto-por-un-valor-aleatorio-largo

# Opcional: exige que las pruebas que necesitan PostgreSQL corran de verdad en
# lugar de omitirse. La integración continua lo pone en 1 siempre.
# PAGAYA_EXIGIR_BD=1
